<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. Backing up the settings store would put the PIN hash and the
  intruder photos into cloud backup, and a restore onto another device would carry someone
  else's lock configuration with it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
