<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive foreground: shield + keyhole, recoloured from the placeholder cyan
  (#45E6FF -> #2E77F2) to the AppLock palette (Taupe #C6B9B2 -> Clay #965F4E).

  Scale: 1.0x. Only the shield's centroid moves (y 552 -> 512) to sit on the layer centre;
  the artwork is otherwise unscaled.

  v1.0.0 scaled this 1.30x and looked visibly cropped on device. Only the central 66.7% of a
  108dp adaptive layer is ever displayed, so at 1.30x the shield filled ~88% of the *visible*
  window and crowded the mask edge. Unscaled it is 464/1024 = 45% of the layer, or ~68% of the
  visible window, which is the conventional proportion. The furthest vertex sits 254px from
  centre, well inside the 341px safe radius, so it survives circle and squircle masks alike.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <path android:pathData="M512,280 L712,356 V526 C712,636 622,700 512,744 C402,700 312,636 312,526 V356 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="316"
                android:startY="296"
                android:endX="708"
                android:endY="732"
                android:type="linear">
                <item android:offset="0" android:color="#FFC6B9B2" />
                <item android:offset="1" android:color="#FF965F4E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Keyhole, knocked through in the darkest warm tone rather than pure black. -->
    <path
        android:pathData="M472,500 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0 Z"
        android:fillColor="#FF1A0F0B" />
    <path
        android:pathData="M482,500 L542,500 L534,596 Q512,614 490,596 Z"
        android:fillColor="#FF1A0F0B" />
</vector>
