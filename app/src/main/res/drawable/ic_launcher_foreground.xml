<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive foreground: shield + keyhole, recoloured from the placeholder cyan
  (#45E6FF -> #2E77F2) to the Latch palette (Taupe #C6B9B2 -> Clay #965F4E).

  Geometry is the source SVG scaled 1.30x about the layer centre and recentred on the
  shield's own centroid (y=552 -> 512). At that scale the furthest vertex sits 330px from
  centre, inside the 341px adaptive safe-zone radius (66.6% of the 1024 viewport), so the
  shield survives both One UI's circle and squircle masks without clipping.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <path android:pathData="M512,210.4 L772,309.2 V530.2 C772,673.2 655,756.4 512,813.6 C369,756.4 252,673.2 252,530.2 V309.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="257.2"
                android:startY="231.2"
                android:endX="766.8"
                android:endY="798"
                android:type="linear">
                <item android:offset="0" android:color="#FFC6B9B2" />
                <item android:offset="1" android:color="#FF965F4E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Keyhole, knocked through in the darkest warm tone rather than pure black. -->
    <path
        android:pathData="M460,496.4 a52,52 0 1,0 104,0 a52,52 0 1,0 -104,0 Z"
        android:fillColor="#FF1A0F0B" />
    <path
        android:pathData="M473,496.4 L551,496.4 L540.6,621.2 Q512,644.6 483.4,621.2 Z"
        android:fillColor="#FF1A0F0B" />
</vector>
