<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer (Android 13+ / One UI). The system tints this as a single silhouette, so
  the keyhole must be a genuine hole rather than a dark shape painted on top: shield outline
  and keyhole are one path with fillType="evenOdd", which subtracts the inner subpath.

  The keyhole is a single union outline (circle arc + tapering stem) rather than two
  overlapping shapes, because under evenOdd an overlap would flip back to filled. The stem
  corners meet the circle at y = 500 + sqrt(40^2 - 30^2) = 526.46.

  Geometry matches ic_launcher_foreground.xml at 1.0x — keep the two in step.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M512,280 L712,356 V526 C712,636 622,700 512,744 C402,700 312,636 312,526 V356 Z M482,526.46 A40,40 0 1,1 542,526.46 L534,596 Q512,614 490,596 Z" />
</vector>
